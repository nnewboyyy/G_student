{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug students_g",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/students_g.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/MinGW/mingw32/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build"
    }
  ]
}
